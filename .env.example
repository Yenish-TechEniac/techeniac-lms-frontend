# ==============================================================================
# Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY WARNING:
# Any variable prefixed with `NEXT_PUBLIC_` is inlined into the client-side
# JavaScript bundle by Next.js and is visible to anyone inspecting network
# traffic, browser memory, or source maps.
#
# NEVER store secrets, private API keys, database connection strings, tokens,
# or credentials in NEXT_PUBLIC_* variables or in client-accessible configs.
# ==============================================================================

# Public API Base URL pointing to the techeniac-lms-backend API (/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
